    given-names: Thanatchon
version: 0.1.3
doi: 10.5281/zenodo.23732290
date-released: 2026-10-28
license: MIT
repository-code: "https://github.com/thanatchon36/sandbank"
keywords:
  - AI safety
  - LLM agents
  - KYC
  - anti-money laundering
  - agent evaluation
